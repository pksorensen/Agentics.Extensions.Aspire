<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared metadata (TFM, versioning, packaging) lives in ../Directory.Build.props. -->
  <PropertyGroup>
    <PackageId>Agentics.Extensions.Aspire.QrCode</PackageId>
    <Description>Aspire hosting integration that adds a clickable "scan me" QR-code link to a resource — opens a localhost page rendering a QR for the resource's endpoint (or any URL), so you can scan it onto your phone.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" Version="13.4.6" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

</Project>
